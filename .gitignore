# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# DR-JEPA artifacts: large, generated or raw data -- never commit
#   data/        simulator episodes (python -m drjepa gen)
#   recordings/  raw SVOs, phone captures, exported + labelled recordings
#   runs/        checkpoints
#   bench/       benchmark outputs and videos
/data/
/recordings/
/runs/
/bench/
*.pt
*.pth
*.onnx
# ... except the published default model (Git LFS, see .gitattributes)
!/models/*.pt
!/models/*.onnx
*.mp4
*.log

# editors / OS
.vscode/
.idea/
.DS_Store
